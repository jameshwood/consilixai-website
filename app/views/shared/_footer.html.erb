<footer class="custom-bg border-t border-gray-800 py-12">
  <div class="mx-auto px-8 md:px-9" style="max-width: 1500px;">
    <div class="flex flex-wrap justify-between gap-8">
      <!-- Logo and description -->
      <div class="space-y-4" style="max-width: 200px;">
        <%= link_to root_path, class: "flex items-center hover:no-underline" do %>
          <%= image_tag "Logo_name_buttercream.png", alt: "Consilix.ai", style: "height: 50px; width: auto;" %>
        <% end %>
      </div>

      <!-- Policies -->
      <div class="space-y-4">
        <h4 class="font-semibold custom-text">Policies</h4>
        <div class="space-y-2">
          <%= link_to "Privacy Policy", "#", class: "block custom-text opacity-60 hover:custom-accent-text hover:opacity-100 transition-all" %>
          <%= link_to "Terms of Service", "#", class: "block custom-text opacity-60 hover:custom-accent-text hover:opacity-100 transition-all" %>
          <%= link_to "Cookie Policy", "#", class: "block custom-text opacity-60 hover:custom-accent-text hover:opacity-100 transition-all" %>
        </div>
      </div>

      <!-- Company -->
      <div class="space-y-4">
        <h4 class="font-semibold custom-text">Company</h4>
        <div class="space-y-2">
          <%= link_to "About Us", about_path, class: "block custom-text opacity-60 hover:custom-accent-text hover:opacity-100 transition-all" %>
          <%# <%= link_to "Case Studies", case_studies_path, class: "block custom-text opacity-60 hover:opacity-100 transition-opacity" %>
          <%= link_to "Contact", contact_path, class: "block custom-text opacity-60 hover:custom-accent-text hover:opacity-100 transition-all" %>
        </div>
      </div>

      <!-- Connect -->
      <div class="space-y-4">
        <h4 class="font-semibold custom-text">Connect</h4>
        <div class="flex" style="gap: 24px;">
          <a href="#" class="custom-text opacity-60 hover:custom-accent-text hover:opacity-100 transition-all">
            <i class="fab fa-linkedin text-2xl"></i>
          </a>
          <a href="#" class="custom-text opacity-60 hover:custom-accent-text hover:opacity-100 transition-all">
            <i class="fab fa-github text-2xl"></i>
          </a>
        </div>
      </div>
    </div>

    <!-- Copyright -->
    <div class="border-t border-gray-800 mt-8 pt-8 text-center">
      <p class="custom-text opacity-60">© 2024 Consilix.ai. All rights reserved.</p>
    </div>
  </div>
</footer>
