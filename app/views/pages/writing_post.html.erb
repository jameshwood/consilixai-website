<%# ─────────────────────────── ARTICLE HEADER ─────────────────────────── %>
<section class="section surface">
  <div class="wrap-narrow">
    <%= link_to writing_path, class: "back-link" do %>
      <span aria-hidden="true">←</span> Field notes
    <% end %>

    <div class="article-meta">
      <span class="meta mono"><%= @post[:date_display] %></span>
      <span class="meta meta-dot" aria-hidden="true">·</span>
      <% @post[:tags].each_with_index do |tag, i| %>
        <span class="meta"><%= tag %></span>
        <% if i < @post[:tags].length - 1 %>
          <span class="meta meta-dot" aria-hidden="true">·</span>
        <% end %>
      <% end %>
    </div>

    <h1 class="article-title"><%= @post[:title] %></h1>

    <p class="lede article-dek"><%= @post[:dek] %></p>
  </div>
</section>

<%# ─────────────────────────── ARTICLE BODY ─────────────────────────── %>
<section class="section-sm surface rule-top">
  <div class="wrap-narrow">
    <article class="article-body">
      <%= @post[:body_html].html_safe %>
    </article>

    <footer class="article-foot">
      <div class="meta">James Wood</div>
      <div class="faint">Founder, Consilix</div>
    </footer>
  </div>
</section>

<%# ─────────────────────────── RELATED NOTES ─────────────────────────── %>
<% if @related.any? %>
  <section class="section surface-alt rule-top">
    <div class="wrap-narrow">
      <div class="sec-head">
        <div class="num">—</div>
        <div class="head-body">
          <span class="kicker">More field notes</span>
          <h2 class="h2">Keep reading.</h2>
        </div>
      </div>

      <div class="related-list">
        <% @related.each do |post| %>
          <%= link_to writing_post_path(slug: post[:slug]), class: "related-item" do %>
            <span class="note-date mono"><%= post[:date_display] %></span>
            <span class="related-title"><%= post[:title] %></span>
            <span class="related-arrow" aria-hidden="true">→</span>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<%# ─────────────────────────── CTA ─────────────────────────── %>
<section class="section surface-ink rule-top">
  <div class="wrap-narrow center">
    <span class="kicker" style="justify-content: center;">Rather talk than read?</span>
    <h2 class="h2" style="margin: 18px auto 16px;">
      Book a call.
    </h2>
    <p class="lede" style="margin: 0 auto 36px;">
      Thirty minutes. No pitch. Bring the part of the business you most wish was running itself.
    </p>
    <%= link_to contact_path, class: "btn btn-primary", style: "background: var(--paper); color: var(--ink);" do %>
      Book a call <span class="arrow" aria-hidden="true">→</span>
    <% end %>
  </div>
</section>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--f-body);
    font-size: 13px;
    color: var(--ink-mute);
    margin-bottom: 40px;
    transition: color .18s ease, transform .18s ease;
  }
  .back-link:hover { color: var(--accent); transform: translateX(-3px); }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }
  .meta-dot { color: var(--ink-faint); }

  .article-title {
    font-family: var(--f-display);
    font-style: normal;
    font-weight: 500;
    font-size: clamp(36px, 5vw, 60px);
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0 0 28px;
    max-width: 22ch;
  }

  .article-dek {
    max-width: 56ch;
    color: var(--ink-mute);
    font-size: clamp(17px, 1.4vw, 20px);
    line-height: 1.5;
  }

  .article-body {
    max-width: 64ch;
    margin: 0;
  }
  .article-body p {
    font-family: var(--f-body);
    font-size: 18px;
    line-height: 1.75;
    color: var(--ink-2);
    margin: 0 0 22px;
  }
  .article-body p:first-child::first-letter {
    font-family: var(--f-display);
    font-style: normal;
    font-weight: 500;
    font-size: 3.4em;
    line-height: 1;
    float: left;
    color: var(--accent);
    margin: 0.02em 12px -0.1em 0;
  }
  .article-body em {
    font-style: normal;
    color: var(--accent);
    font-weight: 500;
  }
  .article-body strong { color: var(--ink); font-weight: 600; }

  .article-foot {
    margin-top: 60px;
    padding-top: 28px;
    border-top: 1px solid var(--rule);
    display: grid;
    gap: 4px;
  }

  .related-list { display: grid; gap: 0; }
  a.related-item {
    display: grid;
    grid-template-columns: 140px 1fr 40px;
    gap: clamp(16px, 2vw, 32px);
    align-items: baseline;
    padding: 22px 0;
    border-top: 1px solid var(--rule);
    transition: background .18s ease, padding .18s ease;
  }
  .related-list .related-item:last-child { border-bottom: 1px solid var(--rule); }
  .related-item:hover { background: var(--paper-3); padding-left: 12px; padding-right: 12px; }
  .related-title {
    font-family: var(--f-display);
    font-style: normal;
    font-weight: 500;
    font-size: 20px;
    letter-spacing: -0.005em;
    color: var(--ink);
    line-height: 1.3;
  }
  .related-arrow {
    font-family: var(--f-body);
    color: var(--ink-faint);
    text-align: right;
    transition: color .18s ease, transform .18s ease;
  }
  .related-item:hover .related-arrow { color: var(--accent); transform: translateX(3px); }

  @media (max-width: 720px) {
    a.related-item { grid-template-columns: 1fr; }
    .related-arrow { display: none; }
  }
</style>
